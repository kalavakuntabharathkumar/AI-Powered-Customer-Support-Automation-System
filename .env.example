# Application settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here

# OpenAI configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# Database configuration
# For PostgreSQL (production):
DATABASE_URL=postgresql://user:password@localhost:5432/support_db
# For SQLite (local development):
# DATABASE_URL=sqlite:///./support_dev.db

# LangChain settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key-here

# Confidence threshold for AI responses (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75

# Simulation settings (for analytics demo)
MANUAL_RESPONSE_TIME_SECONDS=720
AI_RESPONSE_TIME_SECONDS=180
